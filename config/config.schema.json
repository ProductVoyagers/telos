{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telos user config (~/.telos/config.json)",
  "description": "Per-user, per-machine config. Never committed to a workspace repo. Holds identity + secrets + where Telos reads/writes.",
  "type": "object",
  "required": ["schemaVersion", "identity", "sync", "workspace", "designSystem"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "identity": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 }
      }
    },
    "sync": { "enum": ["local", "github"] },
    "workspace": { "type": "string", "minLength": 1 },
    "repo": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "pagesUrl": { "type": ["string", "null"] }
      }
    },
    "designSystem": { "type": "string", "minLength": 1 },
    "defaultProject": { "type": ["string", "null"] },
    "team": { "type": ["string", "null"], "description": "Team/squad label shown in the hub header. Captured at /telos-setup." },
    "figmaToken": { "type": ["string", "null"] },
    "comments": {
      "type": ["object", "null"],
      "description": "Optional. Inline comments on impact-review pages, backed by GitHub Discussions via Giscus. No tokens or secrets — repoId/categoryId are public identifiers. Only meaningful in connected (github) mode. Captured at /telos-setup.",
      "required": ["provider", "repo", "repoId", "categoryId"],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "giscus" },
        "repo": { "type": "string", "minLength": 3, "description": "owner/name of the repo with Discussions enabled (hosts the comment threads)." },
        "repoId": { "type": "string", "minLength": 1, "description": "Public repo id from giscus.app, e.g. R_xxxx." },
        "category": { "type": "string", "minLength": 1, "default": "General", "description": "Discussion category name." },
        "categoryId": { "type": "string", "minLength": 1, "description": "Public category id from giscus.app, e.g. DIC_xxxx." }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sync": { "const": "github" } }, "required": ["sync"] },
      "then": { "required": ["repo"] }
    }
  ]
}
